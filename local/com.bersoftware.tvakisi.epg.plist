<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bersoftware.tvakisi.epg</string>

	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/local/run.sh</string>
	</array>

	<!-- 14:30 ve 22:30 — Mac'in açık olma ihtimalinin yüksek olduğu saatler.
	     (02:30 denendi ama makine gece neredeyse hiç açık olmuyor.)
	     CI 03:00/15:00'te çalışıyor: 14:30'un verisi 15:00'te, 22:30'unki
	     ertesi 03:00'te yayına giriyor. Veri 7 gün ileriyi kapsadığı için
	     birkaç saatlik gecikme fark etmiyor.
	     Mac uykudaysa launchd uyanınca kaçan çalışmayı bir kez telafi eder. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key><integer>14</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key><integer>22</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
	</array>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/tv-akisi-epg/run.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/tv-akisi-epg/run.log</string>

	<key>RunAtLoad</key>
	<false/>

	<!-- ProcessType=Background KULLANMA: macOS o görevleri düşük öncelikli
	     çalıştırıyor ve ~2 dakikalık çekim 10 dakikada bile bitmiyor.
	     Standard, kısa süreli bu iş için doğru olan. -->
	<key>ProcessType</key>
	<string>Standard</string>

</dict>
</plist>
